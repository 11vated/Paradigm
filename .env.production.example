# .env.production.example
# Copy to .env (or load via secrets manager / docker env) for production.
# NEVER commit real secrets.

NODE_ENV=production
PORT=3000
LOG_LEVEL=INFO

# REQUIRED: Strong secret
JWT_SECRET=REPLACE_WITH_openssl_rand_-hex_32

# REQUIRED for prod persistence (instead of JSON files)
DATABASE_URL=postgresql://user:pass@your-db-host:5432/paradigm

REDIS_URL=redis://your-redis:6379
CORS_ORIGINS=https://your-studio-domain.com

# Optional but recommended
APP_URL=https://api.yourdomain.com

# See .env.example for more (LLM, monitoring, onchain, etc.)
# Canvas native: install per OS instructions in .env.example for full server 2D gens.

{
  "name": "paradigm-absolute",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:ci": "npm run typecheck && npm run determinism:check",
    "lint:determinism": "eslint src/lib/kernel src/lib/evolution src/seeds --max-warnings=10000",
    "lint:determinism:strict": "eslint src/lib/kernel src/lib/evolution src/seeds --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "determinism:check": "node scripts/check-determinism-boundary.mjs",
    "contract:report": "tsx scripts/quality-contract-report.mts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:simple": "node --input-type=module --eval \"import { generateMusicV2 } from './src/lib/kernel/generators/music-v2.ts'; const seed = { \\$domain: 'music', \\$name: 'Test' }; generateMusicV2(seed).then(r => console.log('Success:', r.name)).catch(e => console.error('Error:', e.message));\"",
    "test:visual": "npx playwright test tests/visual/regressions.spec.ts",
    "test:visual:update": "npx playwright test tests/visual/regressions.spec.ts --update-snapshots=missing",
    "profile:baseline": "tsx scripts/profile-engines.ts",
    "baseline:screenshots": "tsx scripts/baseline-screenshots.ts",
    "package": "tsx scripts/package.ts",
    "package:win": "tsx scripts/package.ts win",
    "package:mac": "tsx scripts/package.ts mac",
    "package:linux": "tsx scripts/package.ts linux",
    "package:all": "tsx scripts/package.ts all",
    "verify:phase0": "node scripts/verify-phase0.js",
    "quality:contract": "tsx scripts/quality-contract-report.mts",
    "replay": "tsx scripts/replay.mts",
    "golden:write": "tsx scripts/replay.mts golden",
    "golden:verify": "tsx scripts/replay.mts verify-golden",
    "evolve": "tsx scripts/evolve_demo.mts",
    "gspl": "tsx scripts/gspl.mts"
  },

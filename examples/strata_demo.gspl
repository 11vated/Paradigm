// GSPL Strata Elevation Demo (Doctrine v2 Phase 2)
// Demonstrates composition over the 9 strata

seed my_character : character {
  strata: Form + Motion + Mind + Sound;
  
  form: {
    mesh: "humanoid_biped",
    materials: ["skin", "hair", "cloth"]
  };
  
  motion: {
    gait: "graceful_walk",
    animations: ["idle", "run", "transform"]
  };
  
  mind: {
    personality: "curious_explorer",
    behaviors: ["investigate", "transform_on_trigger"]
  };
  
  sound: {
    voice: "soft_female",
    effects: ["transformation_whoosh"]
  };
}

// Universe root using all strata
seed my_universe : universe {
  strata: Form + Motion + Sound + Mind + Story + World + Field + Culture + Time;
  
  world: { /* ... */ };
  field: { /* physics, magic */ };
  culture: { /* ... */ };
  time: { /* chronology */ };
}

grow my_character with my_universe;

// Strata runtime influence demo (strata now *acts* on execution)
let charStrata = strata_of(my_character);
print("Character strata at runtime via strata_of(): " + charStrata);

if (has_stratum(my_character, "Mind")) {
  print("Strata action: Mind stratum present → explorer behavior + intent model enabled");
}

if (has_stratum(my_universe, "Time")) {
  print("Strata action: Time stratum on universe → causality + chronology enforced");
}

let shared = strata_intersect(my_character, my_universe);
print("Strata intersection (composition axis): " + shared);

// Deeper execution: strata now *changes results* (filter + compatibility scoring)
let pop = [my_character, my_universe];
let formOnly = strata_filter(pop, ["Form"]);
print("Strata filter result: " + formOnly.length + " / " + pop.length + " seeds have Form (strata actually reduced the working set)");

let compat = strata_compatible(my_character, my_universe);
print("Strata compatibility score (0-1): " + compat);
if (compat > 0.5) {
  print("Strata action: high compatibility → proceeding with full cross-domain composition");
  // In a real pipeline this would gate a breed/evolve/compose call
} else {
  print("Strata action: low compatibility → falling back to intra-stratum mutation only");
}

// Deeper strata action: strata_prefer + strata_score change *which* seeds feed kernel operations
let mixedPop = [my_character, my_universe];
let storyPreferred = strata_prefer(mixedPop, ["Story"]);
print("strata_prefer by Story: selected " + storyPreferred.length + " seed(s) — " + (storyPreferred[0].$name || storyPreferred[0].name) + " (highest Story alignment)");

let storyScoreChar = strata_score(my_character, ["Story"]);
let storyScoreUni = strata_score(my_universe, ["Story"]);
print("strata_score for Story — character: " + storyScoreChar + ", universe: " + storyScoreUni);

// Simulate using the preferred subset for a subsequent operation (e.g. only grow the Story-strong one)
if (storyPreferred.length > 0) {
  print("Strata-driven selection: only proceeding to grow the Story-preferred seed(s) — strata changed the execution set");
}

// Ultimate strata action: strata now gates real kernel grow calls
print("--- Strata Gating Demo ---");
let gatedResult = strata_gated_grow(my_character, ["Story"]);
print("Gated grow on character for Story: " + (gatedResult.type || 'artifact'));

let preferredGrown = strata_preferred_grow([my_character, my_universe], ["World", "Field"]);
print("Preferred grow results count: " + preferredGrown.length);
if (preferredGrown.length > 0) {
  print("First preferred-grown artifact domain: " + (preferredGrown[0].artifact?.domain || 'n/a'));
}

// Strata now influences evolutionary search outcomes
print("--- Strata-Weighted Evolution Demo ---");
let mixedPop = [my_character, my_universe];
let evolveForStory = strata_weighted_evolve(mixedPop, ["Story"]);
print("Strata-weighted evolve targeting Story — best strata alignment: " + evolveForStory.bestStrataScore.toFixed(2) + " (generation " + evolveForStory.generation + ")");

let evolveForField = strata_weighted_evolve(mixedPop, ["Field"]);
print("Strata-weighted evolve targeting Field — best strata alignment: " + evolveForField.bestStrataScore.toFixed(2));

// Strata now gates compose kernel calls
print("--- Strata Compose Gating Demo ---");
let gatedCompose = strata_gated_compose(my_character, "music", ["Sound"]);
print("Gated compose character→music for Sound: " + (gatedCompose.type || 'composed'));

let preferredComposed = strata_preferred_compose([my_character, my_universe], "narrative", ["Story"]);
print("Preferred compose results count: " + preferredComposed.length);
if (preferredComposed.length > 0) {
  print("First preferred-composed target: " + (preferredComposed[0].targetDomain || 'n/a'));
}

print("Strata runtime demo complete: builtins queried strata, conditionals branched, filter reduced population, compatibility scored, prefer/score selected priority subset, gated_grow and preferred_grow actually changed which grows executed, strata_weighted_evolve changed which individuals won evolution, gated_compose and preferred_compose now gate and select for cross-domain composition — strata now controls kernel call outcomes across grow, evolve, and compose.");
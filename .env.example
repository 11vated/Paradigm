# ─── Paradigm Absolute — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=INFO

# Authentication (generate with: openssl rand -hex 32)
# For production: use a strong, unique secret. Never use the dev fallback.
# In production (NODE_ENV=production), the server will refuse to start without this.
JWT_SECRET=generate-a-random-64-char-hex-string-here  # e.g. openssl rand -hex 32

# CORS (comma-separated origins; defaults to localhost:3000,5173)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL primary for production, JSON fallback for dev)
# Set this to switch from JSON file storage to Postgres (recommended for prod).
# Example for local Postgres: postgresql://user:pass@localhost:5432/paradigm
# In Docker/prod: postgresql://paradigm:password@db:5432/paradigm (see docker-compose)
DATABASE_URL=postgresql://paradigm:paradigm@localhost:5432/paradigm
MONGO_URI=   # leave empty to use PostgreSQL (or set for legacy Mongo)

# Cache
REDIS_URL=redis://redis:6379

# Optional: Gemini API (for embedding generation only — NOT required for core ops)
GEMINI_API_KEY=
APP_URL=http://localhost:3000

# Docker Compose overrides
APP_PORT=3000
NGINX_PORT=80

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=paradigm

# Optional: LLM Inference (fine-tuned Llama 3 for enhanced agent responses)
# Leave blank to use deterministic-only agent
LLAMA_SERVER_URL=http://localhost:8001

# Optional: On-chain minting
SEPOLIA_RPC_URL=

# ─── Canvas Native Libs (for full server-side 2D/character/image generation) ─
# The 'canvas' package is used for server-side SVG/PNG rendering in some generators.
# Without native libs, server falls back to no-op shims (client/browser still works fully).
#
# macOS: brew install pkg-config cairo pango libpng jpeg giflib librsvg
# Windows: 
#   1. Install Visual Studio Build Tools (https://visualstudio.microsoft.com/visual-cpp-build-tools/)
#      - Select "Desktop development with C++" workload
#   2. Install Python (if not present) + add to PATH
#   3. npm rebuild canvas   (or delete node_modules/canvas and npm install)
# Linux: sudo apt-get install build-essential libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev librsvg2-dev
#
# Alternative: Rely on browser/client for rendering (Studio viewports use native Canvas/WebGL).
# This is sufficient for most development and Studio use.
